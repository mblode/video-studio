{
  "$schema": "https://video-studio.blode.md/schemas/tokens.v1.json",
  "version": 1,
  "brand": "Amtec AI",
  "referenceFrame": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "phonePreview": {
      "width": 390,
      "height": 220
    },
    "safeMargins": {
      "xFraction": 0.08,
      "yFraction": 0.1,
      "minPxAt1080p": {
        "x": 154,
        "y": 108
      }
    }
  },
  "palette": {
    "chalk": "#F7F7F7",
    "paper": "#FDFDFC",
    "obsidian": "#121D2C",
    "jetBlack": "#000000",
    "logoBlue": "#0B6EFE",
    "inkBlue": "#0A5FE0",
    "lightBlue": "#5B9BFF",
    "ice": "#E4F2FD",
    "dustySky": "#A7BBD2",
    "slate": "#5B6575"
  },
  "typography": {
    "families": {
      "display": {
        "name": "Söhne",
        "fallback": "Archivo",
        "faces": {
          "400": {
            "postscript": "Sohne-Buch",
            "style": "Buch",
            "file": "sohne-buch.otf"
          },
          "500": {
            "postscript": "Sohne-Kraftig",
            "style": "Kräftig",
            "file": "sohne-kraftig.otf"
          },
          "600": {
            "postscript": "Sohne-Halbfett",
            "style": "Halbfett",
            "file": "sohne-halbfett.otf"
          }
        }
      },
      "mono": {
        "name": "Ioskeley Mono",
        "fallback": "SF Mono",
        "faces": {
          "400": {
            "postscript": "IoskeleyMono-Regular",
            "style": "Regular",
            "file": "ioskeley-mono-regular.ttf"
          },
          "600": {
            "postscript": "IoskeleyMono-Semibold",
            "style": "Semibold",
            "file": "ioskeley-mono-semibold.ttf"
          }
        }
      }
    },
    "roles": {
      "hero": {
        "description": "Single-word or two-word brand climax over footage (e.g. 'Rome.')",
        "family": "display",
        "weight": 600,
        "face": "Halbfett",
        "sizePxAt1080p": 360,
        "resolveBasicTitleSize": 440,
        "lineHeight": 1.0,
        "trackingEm": -0.035,
        "minPhoneCapHeightPx": 48,
        "maxWords": 2
      },
      "title": {
        "description": "Primary thesis statements and proverb claims over footage or blueprint cards",
        "family": "display",
        "weight": 600,
        "face": "Halbfett",
        "sizePxAt1080p": 96,
        "resolveBasicTitleSize": 144,
        "lineHeight": 1.12,
        "trackingEm": -0.028,
        "minPhoneCapHeightPx": 14,
        "maxCharsPerLine": 26,
        "maxLines": 2
      },
      "statement": {
        "description": "Secondary narrative lines or multi-cut word-build phrases",
        "family": "display",
        "weight": 500,
        "face": "Kräftig",
        "sizePxAt1080p": 84,
        "resolveBasicTitleSize": 128,
        "lineHeight": 1.15,
        "trackingEm": -0.024,
        "minPhoneCapHeightPx": 12,
        "maxCharsPerLine": 30,
        "maxLines": 2
      },
      "lockup": {
        "description": "Live 'Amtec' wordmark beside or below the A mark on Chalk cards",
        "family": "display",
        "weight": 500,
        "face": "Kräftig",
        "sizePxAt1080p": 112,
        "resolveBasicTitleSize": 168,
        "lineHeight": 1.0,
        "trackingEm": -0.025,
        "minPhoneCapHeightPx": 16
      },
      "tagline": {
        "description": "End-card descriptor under the lockup ('Enabling AI for your business')",
        "family": "display",
        "weight": 400,
        "face": "Buch",
        "sizePxAt1080p": 44,
        "resolveBasicTitleSize": 68,
        "lineHeight": 1.25,
        "trackingEm": -0.015,
        "minPhoneCapHeightPx": 6.5
      },
      "url": {
        "description": "End-card domain ('amtecai.com'), matching the Söhne lockup",
        "family": "display",
        "weight": 500,
        "face": "Kräftig",
        "sizePxAt1080p": 32,
        "resolveBasicTitleSize": 52,
        "lineHeight": 1.2,
        "trackingEm": -0.01,
        "minPhoneCapHeightPx": 5.0
      }
    }
  },
  "legibility": {
    "minContrastRatio": {
      "vsBackgroundMedian": 7.0,
      "vsBackgroundP75": 5.0,
      "vsBackgroundP90": 4.5,
      "vsBackgroundP95": 3.5
    },
    "maxPersistentGlyphDriftPxAt1080p": 1.0,
    "scrim": {
      "mode": "radial-plus-soft-shadow",
      "radialEllipseWidthFactor": 1.45,
      "radialEllipseHeightFactor": 2.1,
      "autoDensityByBgP90Luminance": [
        {
          "maxBgP90": 0.15,
          "scrimAlpha": 0.25,
          "shadowAlpha": 0.45,
          "shadowBlurPx": 18
        },
        {
          "maxBgP90": 0.3,
          "scrimAlpha": 0.42,
          "shadowAlpha": 0.55,
          "shadowBlurPx": 22
        },
        {
          "maxBgP90": 0.45,
          "scrimAlpha": 0.58,
          "shadowAlpha": 0.65,
          "shadowBlurPx": 24
        },
        {
          "maxBgP90": 1.0,
          "scrimAlpha": 0.72,
          "shadowAlpha": 0.75,
          "shadowBlurPx": 28
        }
      ]
    }
  },
  "pacing": {
    "readingSpeedWordsPerSecond": 3.0,
    "recognitionBufferSeconds": 0.5,
    "maxDwellMultiplierOverReadingTime": 2.0,
    "minClearPictureBufferBeforeNextSentenceSeconds": 0.32,
    "maxTextOnBlackOrBlueprintHoldSeconds": 1.85,
    "maxTotalTextCoverageFraction": 0.62,
    "shotLengthTargetsSeconds": {
      "montage": { "min": 0.33, "median": 0.64, "max": 1.0 },
      "accelerationBurst": { "min": 0.25, "median": 0.33, "max": 0.5 },
      "statementCut": { "min": 0.64, "median": 0.8, "max": 1.33 },
      "heroHold": { "min": 2.0, "median": 3.0, "max": 3.75 },
      "openingCard": { "min": 2.2, "median": 3.2, "max": 4.2 },
      "closingCard": { "min": 3.2, "median": 4.5, "max": 5.5 }
    }
  },
  "audio": {
    "sampleRateHz": 48000,
    "channels": 2,
    "codec": "aac",
    "bitrateKbps": 256,
    "loudness": {
      "webSocialSlack": {
        "targetLufs": -16.0,
        "toleranceLu": 1.0,
        "maxTruePeakDbtp": -1.5,
        "targetLraLu": 8.0,
        "maxLraLu": 12.0,
        "twoPassLinear": true
      },
      "cinemaReference": {
        "targetLufs": -18.0,
        "toleranceLu": 1.0,
        "maxTruePeakDbtp": -1.5,
        "targetLraLu": 10.0,
        "maxLraLu": 15.0,
        "twoPassLinear": true
      }
    }
  },
  "exportPresets": {
    "master1080p": {
      "width": 1920,
      "height": 1080,
      "codec": "libx264",
      "crf": 16,
      "preset": "slow",
      "pixFmt": "yuv420p",
      "colorSpace": "bt709",
      "colorPrimaries": "bt709",
      "colorTransfer": "bt709",
      "movflags": "+faststart"
    },
    "slackWeb1080p": {
      "width": 1920,
      "height": 1080,
      "codec": "libx264",
      "crf": 20,
      "maxrateMbps": 10,
      "bufsizeMbps": 20,
      "preset": "slow",
      "pixFmt": "yuv420p",
      "colorSpace": "bt709",
      "colorPrimaries": "bt709",
      "colorTransfer": "bt709",
      "movflags": "+faststart",
      "maxFileSizeMb": 85
    }
  }
}
