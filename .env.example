# BytePlus ModelArk API key — https://console.bytepluses.com
# Needed for Seedance 2.0 (films/lighthouse) and the dreamina-* Ark ids.
ARK_API_KEY=
# Optional override of the API base URL
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Vercel AI Gateway — default Seedance 2.5 (`bytedance/seedance-2.5`)
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# VERCEL_OIDC_TOKEN=   # set automatically on Vercel; either this or the key

# Optional — MiniMax key for a film whose `film.model` is MiniMax-H3
# https://platform.minimax.io  (H3 is unavailable in the UK, EU, US, and South
# Korea; a key from the wrong region fails as `1004 not authorized`, which
# reads exactly like a bad key)
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io

# Optional — Google Gemini key for Nano Banana stills and Lyria score beds
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional — ElevenLabs for vs narrate (per-line film VO)
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
